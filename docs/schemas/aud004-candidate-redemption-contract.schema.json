{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avinya.example/schemas/aud004-candidate-redemption-contract.schema.json",
  "title": "AUD-004 Candidate Poll and Redemption Contracts",
  "$defs": {
    "poll_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "poll_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "request_id",
        "candidate_ref",
        "retry_after_seconds"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "READY_FOR_REDEMPTION",
            "DENIED",
            "UNAVAILABLE",
            "OUTCOME_UNCERTAIN",
            "EXPIRED"
          ]
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "candidate_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "stage_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "STAGED",
            "ALREADY_STAGED",
            "CONFLICT",
            "DENIED",
            "EXPIRED",
            "UNAVAILABLE",
            "OUTCOME_UNCERTAIN"
          ]
        }
      }
    },
    "redemption_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "idempotency_key",
        "canonical_request_digest",
        "operation_id",
        "binding_digest"
      ],
      "properties": {
        "candidate_ref": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "canonical_request_digest": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "binding_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authenticated_poll_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_authenticated_workload_id",
        "tenant_id",
        "branch_id",
        "authentication_evidence_ref"
      ],
      "properties": {
        "server_authenticated_workload_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "authentication_evidence_ref": {
          "type": "string"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "operation_id",
        "binding_digest",
        "artifact_digest",
        "status",
        "signature_ref"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "binding_digest": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string"
        },
        "status": {
          "enum": [
            "REMOTE_RECEIPT",
            "DELIVERY_CONFIRMED",
            "OUTCOME_UNCERTAIN"
          ]
        },
        "signature_ref": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/poll_request"
    },
    {
      "$ref": "#/$defs/poll_response"
    },
    {
      "$ref": "#/$defs/stage_result"
    },
    {
      "$ref": "#/$defs/redemption_request"
    },
    {
      "$ref": "#/$defs/authenticated_poll_context"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ]
}