{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avinya.example/schemas/aud004-wire-profile-registry.schema.json",
  "title": "AUD-004 Immutable Wire Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "generation",
    "profiles"
  ],
  "properties": {
    "registry_version": {
      "const": "1.0"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "version",
          "status",
          "canonicalization",
          "digest",
          "signature",
          "key_agreement",
          "content_encryption",
          "key_wrapping",
          "aad_profile",
          "signature_preimage_profile",
          "limits",
          "approval"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "PROPOSED",
              "APPROVED",
              "DEPRECATED",
              "REVOKED"
            ]
          },
          "canonicalization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "encoding",
              "duplicate_key_policy"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "encoding": {
                "type": "string"
              },
              "duplicate_key_policy": {
                "const": "REJECT"
              }
            }
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "length_bytes",
              "encoding"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "length_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "encoding": {
                "type": "string"
              }
            }
          },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "key_format",
              "signature_length_bytes",
              "signature_encoding"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "key_format": {
                "type": "string"
              },
              "signature_length_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "signature_encoding": {
                "type": "string"
              }
            }
          },
          "key_agreement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "public_key_format",
              "private_key_custody"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "public_key_format": {
                "type": "string"
              },
              "private_key_custody": {
                "type": "string"
              }
            }
          },
          "content_encryption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "key_length_bytes",
              "nonce_length_bytes",
              "tag_length_bytes",
              "ciphertext_encoding"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "key_length_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "nonce_length_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "tag_length_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "ciphertext_encoding": {
                "type": "string"
              }
            }
          },
          "key_wrapping": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm_id",
              "wrapped_key_encoding",
              "wrapped_key_length_rule"
            ],
            "properties": {
              "algorithm_id": {
                "type": "string"
              },
              "wrapped_key_encoding": {
                "type": "string"
              },
              "wrapped_key_length_rule": {
                "type": "string"
              }
            }
          },
          "aad_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_order",
              "encoding_grammar",
              "recipient_binding"
            ],
            "properties": {
              "field_order": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "encoding_grammar": {
                "type": "string"
              },
              "recipient_binding": {
                "const": "REQUIRED"
              }
            }
          },
          "signature_preimage_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain_label",
              "length_encoding",
              "manifest_encoding",
              "digest_binding"
            ],
            "properties": {
              "domain_label": {
                "type": "string",
                "minLength": 1
              },
              "length_encoding": {
                "type": "string"
              },
              "manifest_encoding": {
                "type": "string"
              },
              "digest_binding": {
                "type": "string"
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_manifest_bytes",
              "max_ciphertext_bytes",
              "max_parse_depth"
            ],
            "properties": {
              "max_manifest_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_ciphertext_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_parse_depth": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "approver_roles",
              "evidence_ref",
              "approved_generation"
            ],
            "properties": {
              "decision_id": {
                "type": "string"
              },
              "approver_roles": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "evidence_ref": {
                "type": "string"
              },
              "approved_generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}