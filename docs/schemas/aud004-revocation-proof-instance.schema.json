{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avinya.example/schemas/aud004-revocation-proof-instance.schema.json",
  "title": "AUD-004 Authority Revocation Proof Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_version",
    "mode",
    "authority_id",
    "domain",
    "subject_id",
    "source_operation_id",
    "destination_workload_id",
    "action_id",
    "purpose_id",
    "checkpoint",
    "authority_sequence",
    "source_generation",
    "issued_at",
    "expires_at",
    "nonce",
    "proof_digest",
    "signature_ref"
  ],
  "properties": {
    "proof_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "AUTHORITY_LEASE",
        "SOURCE_BARRIER_EVENT"
      ]
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "source_operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "destination_workload_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "enum": [
        "SEARCH",
        "CANDIDATE_AUTHORIZATION",
        "READ_COMMIT",
        "REDEMPTION",
        "RELEASE_COMMIT"
      ]
    },
    "authority_sequence": {
      "type": "string",
      "minLength": 1
    },
    "source_generation": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "proof_digest": {
      "type": "string",
      "minLength": 1
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1
    },
    "lease_guarantee": {
      "const": "NO_EFFECTIVE_REVOCATION_DURING_VALID_LEASE"
    },
    "event_type": {
      "enum": [
        "REVOCATION",
        "STATUS_CHANGE",
        "POLICY_CHANGE"
      ]
    }
  }
}