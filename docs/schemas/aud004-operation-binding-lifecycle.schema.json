{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avinya.example/schemas/aud004-operation-binding-lifecycle.schema.json",
  "title": "AUD-004 Candidate to Delivery Operation Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "binding_digest",
    "authenticated_poll",
    "candidate",
    "redemption",
    "artifact",
    "release_permit",
    "transport",
    "receipt",
    "idempotency"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "binding_digest": {
      "type": "string",
      "minLength": 1
    },
    "authenticated_poll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_identity",
        "tenant_id",
        "branch_id",
        "authentication_evidence_ref"
      ],
      "properties": {
        "workload_identity": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "authentication_evidence_ref": {
          "type": "string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_hash",
        "state",
        "binding_digest",
        "expires_at"
      ],
      "properties": {
        "reference_hash": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ISSUED",
            "CONSUMED",
            "EXPIRED",
            "REVOKED"
          ]
        },
        "binding_digest": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "redemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key_digest",
        "request_digest",
        "claim_state"
      ],
      "properties": {
        "idempotency_key_digest": {
          "type": "string"
        },
        "request_digest": {
          "type": "string"
        },
        "claim_state": {
          "enum": [
            "CLAIMED",
            "SAME_REQUEST_REPLAY",
            "CONFLICT",
            "REJECTED"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_digest",
        "profile_id",
        "profile_version",
        "registry_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "registry_digest": {
          "type": "string"
        }
      }
    },
    "release_permit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "generation_vector_digest",
        "revocation_proof_digest",
        "state",
        "expires_at"
      ],
      "properties": {
        "permit_id": {
          "type": "string"
        },
        "generation_vector_digest": {
          "type": "string"
        },
        "revocation_proof_digest": {
          "type": "string"
        },
        "state": {
          "enum": [
            "NOT_ISSUED",
            "EGRESS_ACCEPTED",
            "TRANSPORT_RELEASE_COMMITTED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "attempt_count"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_STARTED",
            "WRITE_ATTEMPTED",
            "LOCAL_SOCKET_ACCEPTED",
            "REMOTE_RECEIPT",
            "DELIVERY_CONFIRMED",
            "OUTCOME_UNCERTAIN"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "binding_digest",
        "artifact_digest",
        "status",
        "signature_ref"
      ],
      "properties": {
        "receipt_id": {
          "type": "string"
        },
        "binding_digest": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string"
        },
        "status": {
          "enum": [
            "REMOTE_RECEIPT",
            "DELIVERY_CONFIRMED",
            "OUTCOME_UNCERTAIN"
          ]
        },
        "signature_ref": {
          "type": "string"
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_digest",
        "request_digest",
        "same_digest_replay",
        "different_digest_result"
      ],
      "properties": {
        "scope_digest": {
          "type": "string"
        },
        "request_digest": {
          "type": "string"
        },
        "same_digest_replay": {
          "const": "SAME_OPERATION"
        },
        "different_digest_result": {
          "const": "CONFLICT"
        }
      }
    }
  }
}