{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avinya.example/schemas/aud004-federation-envelope.schema.json",
  "title": "AUD-004 Profile-Neutral Federation Envelope",
  "description": "Outer transport envelope only. Inner manifest and cryptographic fields are validated exclusively by the immutable approved profile registry entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "profile_id",
    "profile_version",
    "registry_digest",
    "manifest_bytes",
    "signature",
    "recipient_key_ref",
    "encryption_metadata",
    "aad_bytes",
    "ciphertext_bytes"
  ],
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "registry_digest": {
      "type": "string",
      "minLength": 1
    },
    "manifest_bytes": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "key_id",
        "encoded_value"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "encoded_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recipient_key_ref": {
      "type": "string",
      "minLength": 1
    },
    "encryption_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "key_id",
        "nonce",
        "tag",
        "wrapped_key"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "wrapped_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aad_bytes": {
      "type": "string",
      "minLength": 1
    },
    "ciphertext_bytes": {
      "type": "string",
      "minLength": 1
    }
  }
}